    {
      "id": "scene-07-missing",
      "frameType": "scene",
      "holdAfterNarration": 2000,
      "description": "Woman silhouette gazing at framed painting of a girl in a field, flowers on table, warm amber light — carbon suspended in silence, barely moving",
      "image": "assets/images/scene-07-missing.webp",
      "narration": {
        "lines": [
          {
            "text": "Not all of them made it.",
            "enter": 0,
            "exit": 4000,
            "x": 10,
            "y": 15,
            "align": "left"
          },
          {
            "text": "She was good. Too good.",
            "enter": 8000,
            "exit": 12000,
            "x": 10,
            "y": 50,
            "align": "left"
          },
          {
            "text": "Working harder. Paid less.",
            "enter": 13000,
            "exit": 16000,
            "x": 10,
            "y": 56,
            "align": "left"
          },
          {
            "text": "They got done obliging.",
            "enter": 21000,
            "exit": 24000,
            "x": 10,
            "y": 85,
            "align": "left"
          }
        ],
        "captions": [
          {
            "text": "But not all of them made it...",
            "start": 0,
            "end": 3000
          },
          {
            "text": "That girl fresh out of school? She never even got a chance—she was good. Too good.",
            "start": 3000,
            "end": 12000
          },
          {
            "text": "There was lots of women working harder than anybody else in the room and getting paid less for their troubles.",
            "start": 12000,
            "end": 20000
          },
          {
            "text": "Some of them left because folks kept asking them to hide,",
            "start": 20000,
            "end": 24000
          },
          {
            "text": "and I reckon they'd just got done obliging.",
            "start": 24000,
            "end": 27000
          }
        ]
      },
