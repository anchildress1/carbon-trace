          "fadeOut": 500
        }
      ]
    },
    {
      "id": "scene-05-rinse",
      "frameType": "scene",
      "holdAfterNarration": 2500,
      "description": "Hands holding diamond with circuitry under running water in a metal sink, coins in basin — carbon entering the water cycle",
      "image": "assets/images/scene-05-rinse.webp",
      "narration": {
        "lines": [
          {
            "text": "Trained in all the hard things.",
            "enter": 2000,
            "exit": 5000,
            "x": 72,
            "y": 37
          },
          {
            "text": "Put on your big girl panties.",
            "enter": 8500,
            "exit": 12000,
            "x": 61,
            "y": 23
          },
          {
            "text": "The dust started washing off.",
            "enter": 32000,
            "exit": 34000,
            "x": 17,
            "y": 8
          },
          {
            "text": "Nobody expected that to look like me.",
            "enter": 40000,
            "exit": 44000,
            "x": 65,
            "y": 79
          }
        ],
        "captions": [
          {
            "text": "By the time I found my way into tech, I'd already been trained in all the hard things.",
            "start": 0,
            "end": 4800
          },
          {
            "text": "Every time I thought about quitting school, I'd think of my Mommy telling me to put on my big girl panties.",
            "start": 6000,
            "end": 12000
          },
          {
            "text": "She still tells me that.",
            "start": 12000,
            "end": 14500
          },
          {
            "text": "And that was just our way of saying just because it's hard don't mean you ain't gonna do it.",
            "start": 15000,
            "end": 20000
          },
          {
            "text": "So I used all the stubbornness and grit from the mountains",
            "start": 20000,
            "end": 25500
          },
          {
            "text": "and did a whole lot of just showing up to finish my schoolin'.",
            "start": 26000,
            "end": 29000
          },
          {
            "text": "Somewhere along the way, the dust started washing off.",
            "start": 30000,
            "end": 33000
          },
          {
            "text": "Turns out what was under it was rightly what this kind of work needed.",
            "start": 34000,
            "end": 39000
          },
          {
            "text": "Now, I don't think nobody was quite expecting that to look like me by the time I showed up.",
            "start": 39000,
            "end": 45000
          },
          {
            "text": "But I didn't rightly care neither.",
            "start": 46000,
            "end": 48000
          }
        ]
      },
      "effects": {
        "regions": [
          {
            "type": "water",
            "mask": "assets/masks/mask-05-rinse-water.png"
          },
          {
            "type": "glow",
            "mask": "assets/masks/mask-05-rinse-diamond.png",
            "color": 16642996,
            "glowAlpha": 0.15,
            "distance": 12,
            "outerStrength": 2.5,
            "pulseSpeed": 0.02,
            "pulseDepth": 0.4
          }
        ]
      },
      "transition": {
        "type": "fade",
        "duration": 1200
      },
      "audioCues": [
        {
          "id": "narration",
          "type": "narration",
          "src": "assets/audio/narration/05-rinse.m4a",
          "enter": 500,
          "volume": 1,
          "loop": false,
          "fadeIn": 0,
