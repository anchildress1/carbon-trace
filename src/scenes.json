      "holdAfterNarration": 2000,
      "description": "Woman silhouette holding tin in glowing corridor, circuit traces on walls and floor — carbon cycling back",
      "image": "assets/images/scene-09-return.webp",
      "narration": {
        "lines": [
          {
            "text": "My world had a plan for me.",
            "enter": 2000,
            "exit": 4000,
            "x": 10,
            "y": 15,
            "align": "left"
          },
          {
            "text": "I just didn't take it.",
            "enter": 4000,
            "exit": 7000,
            "x": 10,
            "y": 21,
            "align": "left"
          },
          {
            "text": "I ain't done with it yet.",
            "enter": 12000,
            "exit": 14000,
            "x": 10,
            "y": 50,
            "align": "left"
          },
          {
            "text": "Don't lose your fight.",
            "enter": 24000,
            "exit": 26000,
            "x": 10,
            "y": 85,
            "align": "left"
          }
        ],
        "captions": [
          {
            "text": "My world had a plan for me before I ever got here.",
            "start": 0,
            "end": 3000
          },
          {
            "text": "I just didn't take what they was giving.",
            "start": 3000,
            "end": 6000
          },
          {
            "text": "And I remember all those things handed to me over the years and I ain't done with it yet.",
            "start": 6000,
            "end": 14000
          },
          {
            "text": "Everything all the women before me hauled around—that matters.",
            "start": 14000,
            "end": 22000
          },
          {
            "text": "And all of you walking beside me while the industry aims to fix us—don't lose your fight.",
            "start": 22000,
            "end": 30000
          },
          {
            "text": "If nothing else, then we'll do it for all the youngins coming up next.",
            "start": 30000,
            "end": 35000
          },
          {
            "text": "Cause they're gonna need things to look a little bit brighter before they get here.",
            "start": 35000,
            "end": 40000
