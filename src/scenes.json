        }
      ]
    },
    {
      "id": "scene-06-storage",
      "frameType": "scene",
      "holdAfterNarration": 2000,
      "description": "Hands opening round tin revealing diamond glowing on coins, old photograph inside — carbon quietly accumulated and set aside",
      "image": "assets/images/scene-06-storage.webp",
      "narration": {
        "lines": [
          {
            "text": "Built things other people got credit for.",
            "enter": 8000,
            "exit": 11000,
            "x": 5,
            "y": 63
          },
          {
            "text": "Solved problems quietly.",
            "enter": 12000,
            "exit": 15000,
            "x": 64,
            "y": 85
          },
          {
            "text": "There were special women along the way.",
            "enter": 17000,
            "exit": 20000,
            "x": 5,
            "y": 35
          },
          {
            "text": "Carrying the light as if they'd been the ones underground.",
            "enter": 38000,
            "exit": 42000,
            "x": 50,
            "y": 16
          }
        ],
        "captions": [
          {
            "text": "I caught on fast enough to how this industry works.",
            "start": 0,
            "end": 2600
          },
          {
            "text": "I learned to keep my head down and do whatever work was thrown at me.",
            "start": 3700,
            "end": 7500
          },
          {
            "text": "I built things that other people usually got the credit for.",
            "start": 8000,
            "end": 11000
          },
          {
            "text": "And I solved problems quietly because that's how I stayed out of trouble.",
            "start": 11000,
            "end": 16000
          },
          {
            "text": "There were special women along the way too.",
            "start": 17000,
            "end": 19500
          },
          {
            "text": "There always are, if you know where to look for them.",
            "start": 20000,
            "end": 23000
          },
          {
            "text": "They'd already walked through the fire and wouldn't nobody gonna make you feel smaller if you was still in it.",
            "start": 24000,
            "end": 30000
          },
          {
            "text": "They didn't talk big because they didn't need to.",
            "start": 30000,
            "end": 33000
          },
          {
            "text": "They just quietly shined the way.",
            "start": 34000,
            "end": 36000
          },
          {
            "text": "Walking in front of you—carrying the light as if they'd been the ones underground.",
            "start": 36000,
            "end": 42000
          }
        ]
      },
      "effects": {
        "regions": [
          {
            "type": "glow",
            "mask": "assets/masks/mask-06-storage-diamond.png",
            "color": 16775408,
            "glowAlpha": 0.25,
            "distance": 15,
            "outerStrength": 3,
            "pulseSpeed": 0.03,
            "pulseDepth": 0.4
          }
        ]
      },
