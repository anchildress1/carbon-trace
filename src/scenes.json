      "frameType": "scene",
      "holdAfterNarration": 16000,
      "description": "Sparse room with tin on wall shelf, circuitry glowing on walls, bright window — a space where someone should be but isn't",
      "image": "assets/images/scene-08-empty.webp",
      "narration": {
        "lines": [
          {
            "text": "All of them should still be here.",
            "enter": 0,
            "exit": 6000,
            "x": 8,
            "y": 21
          },
          {
            "text": "It's not supposed to be this quiet.",
