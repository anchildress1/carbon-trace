    {
      "id": "scene-06-storage",
      "frameType": "scene",
      "holdAfterNarration": 2000,
      "description": "Hands opening round tin revealing diamond glowing on coins, old photograph inside — carbon quietly accumulated and set aside",
      "image": "assets/images/scene-06-storage.webp",
      "narration": {
        "lines": [
          {
            "text": "Built things other people got credit for.",
            "enter": 7000,
            "exit": 10000,
            "x": 10,
            "y": 12,
            "align": "left"
          },
          {
            "text": "Solved problems quietly.",
            "enter": 10000,
            "exit": 13000,
            "x": 10,
            "y": 18,
            "align": "left"
          },
          {
            "text": "There were special women along the way.",
            "enter": 17000,
            "exit": 19000,
            "x": 50,
            "y": 50,
            "align": "center"
          },
          {
            "text": "Carrying the light as if they'd been the ones underground.",
            "enter": 40000,
            "exit": 44000,
            "x": 50,
            "y": 88,
            "align": "center"
          }
        ],
        "captions": [
          {
            "text": "For a long time I just did whatever work was thrown at me.",
            "start": 0,
            "end": 4000
          },
          {
            "text": "I kept my head down and built things that other people usually got the credit for.",
            "start": 4000,
            "end": 10000
          },
          {
            "text": "I solved problems quietly because that's the way I'd been taught to do it.",
            "start": 10000,
            "end": 15000
          },
          {
            "text": "There were special women along the way though.",
            "start": 15000,
            "end": 18000
          },
          {
            "text": "There always are, if you know where to look for them.",
            "start": 18000,
            "end": 23000
          },
          {
            "text": "They'd already walked through the fire and not one of them was gonna make you feel smaller if you was still in it.",
            "start": 23000,
            "end": 30000
          },
          {
            "text": "They didn't talk big because they didn't have to.",
            "start": 30000,
            "end": 34000
          },
          {
            "text": "They just quietly shined the way.",
            "start": 34000,
            "end": 37000
          },
          {
            "text": "Walking in front of you—carrying the light as if they'd been the ones underground.",
            "start": 37000,
            "end": 44000
          }
        ]
      },
      "effects": {
        "regions": [
          {
            "type": "glow",
