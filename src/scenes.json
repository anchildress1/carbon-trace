          },
          {
            "text": "Because it's mine.",
            "enter": 5000,
            "exit": 8000,
            "x": 50,
            "y": 40
          }
        ],
        "captions": [
          {
            "text": "[Appalachian English dialect]",
            "start": 100,
            "end": 1800
          },
          {
            "text": "I'm gonna tell you a story.",
            "start": 100,
            "end": 1800
          },
          {
            "text": "Not because it's special. But because it's mine.",
            "start": 3000,
            "end": 6500
          },
          {
            "text": "And my Daddy always told me to finish what I started.",
            "start": 6500,
            "end": 10000
          }
        ]
      },
      "effects": null,
