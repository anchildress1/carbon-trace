    {
      "id": "scene-11-music",
      "frameType": "credits",
      "holdAfterNarration": 2000,
      "description": "Woman standing before record player on wooden table with diamond glowing, circuit traces and sparkles filling the bright room — the finale",
      "image": "assets/images/scene-11-music.webp",
      "narration": {
        "lines": [
          {
            "text": "I want to leave more than I got.",
            "enter": 2000,
            "exit": 6000,
            "x": 67,
            "y": 71
          },
          {
            "text": "One little corner of the universe.",
            "enter": 18000,
            "exit": 21000,
            "x": 54,
            "y": 30
          },
          {
            "text": "It's not dark no more.",
            "enter": 20000,
            "exit": 23000,
            "x": 19,
            "y": 75
          },
          {
            "text": "Catch like wildfire.",
            "enter": 25000,
            "exit": 28000,
            "x": 42,
            "y": 36
          }
        ],
        "captions": [
          {
            "text": "So that's what I built all this is for.",
            "start": 0,
            "end": 2200
          },
          {
            "text": "I want to leave more than I got when I started out.",
            "start": 2200,
            "end": 6000
          },
          {
            "text": "I want it easier for the next ones coming up to build smart things without having to fight for every inch of it first.",
            "start": 8000,
            "end": 14000
          },
          {
            "text": "So this is me putting the light—and some music—into this one little corner of the universe so it's not dark no more.",
            "start": 14000,
            "end": 23000
          },
          {
            "text": "And if we're lucky, it will catch like wildfire.",
            "start": 26000,
            "end": 32000
          }
        ]
