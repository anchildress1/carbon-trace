    {
      "id": "scene-05-rinse",
      "frameType": "scene",
      "holdAfterNarration": 2500,
      "description": "Hands holding diamond with circuitry under running water in a metal sink, coins in basin — carbon entering the water cycle",
      "image": "assets/images/scene-05-rinse-1a364a77.webp",
