    {
      "id": "scene-04-pocket",
      "frameType": "scene",
      "holdAfterNarration": 2000,
      "description": "Diamond with glowing circuitry in coal grit, coins and worn fabric — carbon carried as something personal",
      "image": "assets/images/scene-04-pocket.webp",
      "narration": {
        "lines": [
          {
            "text": "I left home toting more than I knew.",
            "enter": 0,
            "exit": 2700,
            "x": 66,
            "y": 44
          },
          {
            "text": "Not money. Not a plan.",
            "enter": 5000,
            "exit": 8000,
            "x": 15,
            "y": 11
          },
          {
            "text": "16 of us for Sunday supper.",
            "enter": 18000,
            "exit": 21000,
            "x": 6,
            "y": 34
          },
          {
            "text": "Something took root.",
            "enter": 25000,
            "exit": 28000,
            "x": 70,
            "y": 60
          },
          {
            "text": "I had it in my pocket the whole time.",
            "enter": 40000,
            "exit": 43000,
            "x": 67,
            "y": 19
          }
        ],
        "captions": [
          {
            "text": "I left home toting more than I knew.",
            "start": 0,
            "end": 2400
          },
          {
            "text": "Not money—we didn't have none of that.",
            "start": 3000,
            "end": 6000
          },
          {
            "text": "Not a plan neither—I guess nobody thought to hand me one of those and I probably wouldn't have listened no how.",
            "start": 6600,
            "end": 14000
          },
          {
            "text": "But somewhere between watching my Mawmaw stretch a meal to feed 16 of us for Sunday supper",
            "start": 15000,
            "end": 21000
          },
          {
            "text": "and watching my mommy hold that house together on nothing, something took root.",
            "start": 21500,
            "end": 26000
          },
          {
            "text": "I didn't learn how to survive by reading about it—",
            "start": 27000,
            "end": 30000
          },
          {
            "text": "I learned because I watched them all do it every single day.",
            "start": 30500,
            "end": 34000
          },
          {
            "text": "I didn't rightly know what it was back then.",
            "start": 34000,
            "end": 38000
          },
          {
            "text": "It just felt like the way I was made.",
            "start": 38000,
            "end": 40000
          },
          {
            "text": "But I had it in my pocket the whole time.",
            "start": 41000,
            "end": 44000
          }
        ]
      },
      "effects": {
        "regions": [
          {
            "type": "glow",
            "mask": "assets/masks/mask-04-pocket-diamond.png",
            "color": 15909236,
            "glowAlpha": 0.15,
            "distance": 6,
            "outerStrength": 2,
            "pulseSpeed": 0.03,
            "pulseDepth": 0.4
          }
        ]
      },
      "transition": {
        "type": "fade",
        "duration": 1200
      },
      "audioCues": [
        {
          "id": "narration",
          "type": "narration",
          "src": "assets/audio/narration/04-pocket.m4a",
          "enter": 500,
          "volume": 1,
          "loop": false,
          "fadeIn": 0,
          "fadeOut": 0
        },
        {
          "id": "ambient-04",
          "type": "ambient",
          "src": "assets/audio/ambient/04-pocket-clock.m4a",
          "enter": 0,
          "volume": 0.15,
