      "image": "assets/images/scene-01-seam.jpg",
      "advanceMode": "click",
      "textMode": "ghost-drift",
      "narration": {
        "lines": [
          {
            "text": "The world had already decided what everything was.",
            "enter": 500,
            "exit": 4000
          },
          {
            "text": "Pressure was not a problem. Pressure was the address.",
            "enter": 2000,
            "exit": 6000
          }
        ],
        "audio": "assets/audio/narration/scene-01-buried.mp3",
        "delay": 500
      },
      "ambient": {
        "src": "assets/audio/ambient/scene-01-buried.mp3",
        "volume": 0.15,
        "loop": true
      },
      "effects": { "idle": "dust-drift", "entry": "fade-in" },
      "transition": { "type": "zoom-in", "duration": 1200, "scale": { "from": 1.0, "to": 1.15 } },
      "traceOverlay": { "opacity": 0.05, "animation": "shimmer" }
