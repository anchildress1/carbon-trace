    {
      "id": "scene-09-return",
      "frameType": "scene",
      "holdAfterNarration": 2000,
      "description": "Woman silhouette holding tin in glowing corridor, circuit traces on walls and floor — carbon cycling back",
      "image": "assets/images/scene-09-return.webp",
      "narration": {
        "lines": [
          {
            "text": "I refuse to let all that be forgot.",
            "enter": 100,
            "exit": 3000,
            "x": 3,
            "y": 56
          },
          {
            "text": "Way past time.",
            "enter": 11000,
            "exit": 14000,
            "x": 74,
            "y": 22
          },
          {
            "text": "Don't lose your fight.",
            "enter": 23000,
            "exit": 27000,
            "x": 62,
            "y": 51
          },
          {
            "text": "A little bit brighter.",
            "enter": 29000,
            "exit": 33000,
            "x": 7,
            "y": 64
          }
        ],
        "captions": [
          {
            "text": "I refuse to let all that be forgot.",
            "start": 0,
            "end": 3000
          },
          {
            "text": "Sitting on a shelf that ain't nobody gonna remember.",
            "start": 3000,
            "end": 6000
          },
          {
            "text": "So I pack it with me.",
            "start": 6000,
            "end": 9000
          },
          {
            "text": "And I finally decided it's way past time to do something with it.",
            "start": 10000,
            "end": 14000
          },
          {
            "text": "Everything all the women before me hauled around—that matters.",
            "start": 14000,
            "end": 20000
          },
          {
            "text": "And all of you walking beside me while the industry aims to fix us—don't lose your fight.",
            "start": 20000,
            "end": 26000
          },
          {
            "text": "If nothing else, then we'll do it for all the youngins coming up who need these things to be a little bright before they get here.",
            "start": 26000,
            "end": 34000
          }
        ]
      },
