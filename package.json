{
  "name": "carbon-trace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Immersive visual narrative — WeCoded 2026 Frontend Art Entry",
  "author": "Ashley Childress",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{js,css,html,json}' '*.{js,json,html,yml,yaml,md}'",
    "format:check": "prettier --check 'src/**/*.{js,css,html,json}' '*.{js,json,html,yml,yaml,md}'",
    "perf": "lhci autorun"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "howler": "^2.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@checkmarkdevtools/commitlint-plugin-rai": "^0.1.6",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.4",
    "lefthook": "^2.1.4",
    "prettier": "^3.5.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "volta": {
    "node": "22.16.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ],
    "overrides": {
      "tmp": ">=0.2.3"
    }
  }
}
